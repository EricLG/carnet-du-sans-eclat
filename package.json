{
  "name": "carnet-du-sans-eclat",
  "private": true,
  "description": "Un carnet de voyage pour suivre ses quêtes dans Elden Ring.",
  "license": "0BSD",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.24",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "9",
    "eslint-config-expo": "~58.0.4",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --lan --port 8081",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser/parties.mjs && node --import tsx tests/browser/quests.mjs && node tests/browser/backups.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0"
  }
}
